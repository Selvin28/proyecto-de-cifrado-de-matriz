import tkinter as tk
from tkinter import messagebox, Toplevel
import numpy as np
import pyperclip

#FUNCIONES PRINCIPALES  

def generar_matriz_clave():
    """Retorna una matriz 2x2 fija (clave predefinida)."""
    return np.array([[3, 3], [2, 5]])  

def validar_matriz_invertible(matriz):
    det = int(round(np.linalg.det(matriz)))
    return np.gcd(det % 26, 26) == 1

def inversa_modular_matriz(matriz):
    det = int(round(np.linalg.det(matriz)))
    det_inv = pow(det, -1, 26)
    matriz_adj = np.array([[matriz[1][1], -matriz[0][1]], [-matriz[1][0], matriz[0][0]]])
    return (det_inv * matriz_adj) % 26

def hill_cifrar(texto, matriz_clave):
    texto = texto.upper().replace(" ", "")
    if len(texto) % 2 != 0:
        texto += "X"
    resultado = ""
    for i in range(0, len(texto), 2):
        vec = np.array([[ord(texto[i]) - 65], [ord(texto[i + 1]) - 65]])
        cif = np.dot(matriz_clave, vec) % 26
        resultado += chr(cif[0][0] + 65) + chr(cif[1][0] + 65)
    return resultado

def hill_descifrar(texto, matriz_clave):
    matriz_inv = inversa_modular_matriz(matriz_clave)
    texto = texto.upper().replace(" ", "")
    if len(texto) % 2 != 0:
        texto += "X"
    resultado = ""
    for i in range(0, len(texto), 2):
        vec = np.array([[ord(texto[i]) - 65], [ord(texto[i + 1]) - 65]])
        dec = np.dot(matriz_inv, vec) % 26
        resultado += chr(int(dec[0][0]) + 65) + chr(int(dec[1][0]) + 65)
    return resultado

#FUNCIONES GUI 

def centrar_ventana(ventana):
    ventana.update_idletasks()
    w = ventana.winfo_width()
    h = ventana.winfo_height()
    x = (ventana.winfo_screenwidth() // 2) - (w // 2)
    y = (ventana.winfo_screenheight() // 2) - (h // 2)
    ventana.geometry(f"+{x}+{y}")

def ventana_operacion(modo, ventana_principal):
    """Ventana para Cifrar o Descifrar (botones: ejecutar, copiar, regresar)."""
    ventana_principal.withdraw()

    ventana = tk.Toplevel()
    ventana.title(f"{modo} - EncDec")
    ventana.config(bg="#EAF2FA")
    ventana.geometry("620x600")
    ventana.minsize(560, 460)

    frame = tk.Frame(ventana, bg="#EAF2FA", padx=18, pady=18)
    frame.pack(expand=True, fill="both")

    tk.Label(frame, text=f"=== {modo.upper()} ===",
             font=("Arial Rounded MT Bold", 18, "bold"), bg="#EAF2FA", fg="#2A4D69").pack(pady=8)

    tk.Label(frame, text="Texto:", bg="#EAF2FA", fg="#2A4D69", font=("Arial", 12, "bold")).pack(anchor="w")
    entrada_texto = tk.Entry(frame, width=58, font=("Arial", 12), relief="groove", bd=2)
    entrada_texto.pack(pady=6)

    matriz_clave = generar_matriz_clave()
    matriz_frame = tk.Frame(frame, bg="#DCE6F0", bd=2, relief="ridge", padx=10, pady=10)
    matriz_frame.pack(pady=12, fill="x")

    tk.Label(matriz_frame, text="Matriz Clave 2x2 utilizada:", bg="#DCE6F0",
             fg="#2A4D69", font=("Arial", 11, "bold")).pack(anchor="w")

    matriz_grid = tk.Frame(matriz_frame, bg="#DCE6F0")
    matriz_grid.pack(pady=8)

    for i in range(2):
        for j in range(2):
            cell = tk.Label(matriz_grid, text=str(matriz_clave[i][j]),
                            font=("Consolas", 14, "bold"), width=5, height=2,
                            bg="#AFCBFF", fg="#1B3358", relief="ridge", bd=2)
            cell.grid(row=i, column=j, padx=6, pady=6)

    tk.Label(frame, text="Resultado:", bg="#EAF2FA", fg="#2A4D69", font=("Arial", 12, "bold")).pack(anchor="w", pady=(10,0))
    resultado_texto = tk.Text(frame, height=5, width=70, font=("Consolas", 12), wrap="word", relief="groove", bd=2)
    resultado_texto.pack(pady=6)

    def ejecutar_operacion():
        texto = entrada_texto.get().strip()
        if not texto:
            messagebox.showwarning("Aviso", "Escribe un texto para procesar.")
            return
        try:
            if not validar_matriz_invertible(matriz_clave):
                messagebox.showerror("Error", "La matriz no es invertible módulo 26.")
                return
            if modo == "Cifrar":
                resultado = hill_cifrar(texto, matriz_clave)
            else:
                resultado = hill_descifrar(texto, matriz_clave)
            resultado_texto.config(state="normal")
            resultado_texto.delete("1.0", tk.END)
            resultado_texto.insert(tk.END, resultado)
            resultado_texto.config(state="disabled")
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def copiar_resultado():
        texto = resultado_texto.get("1.0", tk.END).strip()
        if texto:
            pyperclip.copy(texto)
            messagebox.showinfo("100%", "Se copio correctamente.")
        else:
            messagebox.showwarning("Aviso", "No hay resultado para copiar.")

    def regresar():
        ventana.destroy()
        ventana_principal.deiconify()

    botones_frame = tk.Frame(frame, bg="#EAF2FA")
    botones_frame.pack(pady=14)

    btn_ejecutar = tk.Button(botones_frame, text=modo, command=ejecutar_operacion,
                             bg="#2A4D69", fg="white", font=("Arial Rounded MT Bold", 12),
                             activebackground="#345B8C", padx=18, pady=8, relief="flat", cursor="hand2")
    btn_ejecutar.grid(row=0, column=0, padx=10)

    btn_copiar = tk.Button(botones_frame, text="Copiar", command=copiar_resultado,
                           bg="#4CAF50", fg="white", font=("Arial Rounded MT Bold", 12),
                           activebackground="#3D8B3D", padx=18, pady=8, relief="flat", cursor="hand2")
    btn_copiar.grid(row=0, column=1, padx=10)

    btn_regresar = tk.Button(botones_frame, text="Regresar", command=regresar,
                             bg="#4B86B4", fg="white", font=("Arial Rounded MT Bold", 12),
                             activebackground="#2F5E8E", padx=18, pady=8, relief="flat", cursor="hand2")
    btn_regresar.grid(row=0, column=2, padx=10)

    centrar_ventana(ventana)

#INTERFAZ PRINCIPAL 

def abrir_despedida():
    despedida = Toplevel()
    despedida.title("Gracias")
    despedida.config(bg="#EAF2FA")
    despedida.geometry("420x240")
    despedida.minsize(360, 200)

    tk.Label(despedida, text="¡Gracias por usar EncDec!", bg="#EAF2FA",
             fg="#2A4D69", font=("Arial Rounded MT Bold", 16)).pack(pady=12)
    tk.Label(despedida, text="Desarrollado con fines educativos\npor Grupo 1",
             bg="#EAF2FA", fg="#1B3358", font=("Arial", 10)).pack(pady=8)

    def cerrar_todo():
        despedida.destroy()
        root.destroy()

    tk.Button(despedida, text="Salir ahora", command=cerrar_todo,
              bg="#E74C3C", fg="white", font=("Arial Rounded MT Bold", 12),
              padx=20, pady=8, relief="flat", cursor="hand2").pack(pady=12)

    centrar_ventana(despedida)

def on_salir_principal():
    abrir_despedida()

root = tk.Tk()
root.title("EncDec - Cifrado Hill 2x2")
root.config(bg="#C7D4E3")
root.geometry("480x360")
root.minsize(420, 320)

tk.Label(root, text="EncDec",
         font=("Arial Rounded MT Bold", 30, "bold"), bg="#C7D4E3", fg="#2A4D69").pack(pady=24)

frame_botones = tk.Frame(root, bg="#C7D4E3")
frame_botones.pack(pady=20)

btn_cifrar = tk.Button(frame_botones, text="Cifrar", command=lambda: ventana_operacion("Cifrar", root),
                       bg="#2A4D69", fg="white", font=("Arial Rounded MT Bold", 14),
                       activebackground="#345B8C", padx=28, pady=10, relief="flat", cursor="hand2")
btn_cifrar.grid(row=0, column=0, padx=18)

btn_descifrar = tk.Button(frame_botones, text="Descifrar", command=lambda: ventana_operacion("Descifrar", root),
                          bg="#4B86B4", fg="white", font=("Arial Rounded MT Bold", 14),
                          activebackground="#356B9A", padx=28, pady=10, relief="flat", cursor="hand2")
btn_descifrar.grid(row=0, column=1, padx=18)

tk.Button(root, text="Salir", command=on_salir_principal,
          bg="#E74C3C", fg="white", font=("Arial Rounded MT Bold", 12),
          padx=22, pady=8, relief="flat", cursor="hand2").pack(pady=18)

root.protocol("WM_DELETE_WINDOW", on_salir_principal)

centrar_ventana(root)
root.mainloop()


